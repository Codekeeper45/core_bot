# ── LLM (OpenRouter) ────────────────────────────────────────────────
# STT + Vision + текстовый агент. Обязателен.
OPENROUTER_API_KEY=
# Главный мозг бота по OpenRouter: DeepSeek V4 Flash.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Глобальный фолбэк для любых LLM-вызовов (роутер бесплатных моделей).
OPENROUTER_FALLBACK_MODEL=openrouter/free

# ── LLM (DeepSeek, опционально) ─────────────────────────────────────
# Если задан DEEPSEEK_API_KEY — становится основным текстовым провайдером,
# OpenRouter остаётся как fallback (+ STT/Vision).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── LLM (AnyModel, опционально) ─────────────────────────────────────
# Третий провайдер умной цепочки главного мозга (после DeepSeek-на-OpenRouter,
# перед openrouter/free). OpenAI-совместимый эндпоинт anymodel.org.
ANYMODEL_API_KEY=
ANYMODEL_BASE_URL=https://anymodel.org/v1
ANYMODEL_MODEL=am/glm-5.2

# ── STT / Vision / Video (OpenRouter) ───────────────────────────────
# Распознавание речи: primary Whisper; fallback — мультимодальный nemotron
# (принимает голосовые через chat-audio, нужно протестировать).
STT_MODEL=openai/whisper-large-v3-turbo
STT_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Картинки и видео: primary Gemini; fallback — глобальный бесплатный роутер.
VISION_MODEL=google/gemini-3.1-flash-lite-preview
VISION_FALLBACK_MODEL=openrouter/free
VIDEO_MODEL=google/gemini-3.1-flash-lite-preview
VIDEO_FALLBACK_MODEL=openrouter/free

# ── MySQL (подключи свою БД) ────────────────────────────────────────
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ── Server ──────────────────────────────────────────────────────────
PORT=3000
BOT_NAME=AI-бот

# ── WhatsApp (Baileys) ──────────────────────────────────────────────
WA_AUTH_DIR=auth_info_baileys
WA_PAIRING_PHONE=
# Номера руководителей и дополнительных администраторов политик, через запятую.
BOSS_CONTACTS=
POLICY_ADMIN_CONTACTS=
# Группа только для наблюдения: JID 120...@g.us и/или точное название через запятую.
OBSERVE_ONLY_GROUP_WA=
OBSERVE_ONLY_GROUP_NAMES=Склад отгрузки
# Максимальный размер сохраняемого голосового для повторной расшифровки (байты).
OBSERVED_GROUP_AUDIO_MAX_BYTES=33554432
# Кому разрешён group_report в ЛС. Номера надёжнее имён; Стас — запасной default.
GROUP_REPORT_REQUESTERS_WA=
GROUP_REPORT_REQUESTER_NAMES=Стас

# Страница удалённой привязки /pair — задай случайный токен 16+ символов,
# иначе страница отдаёт 503. ENABLE_TUNNEL=1 поднимает Cloudflare Quick Tunnel.
PAIR_TOKEN=
ENABLE_TUNNEL=0

# ── Telegram ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=https://your-domain.com
# Секрет для проверки вебхука Telegram (X-Telegram-Bot-Api-Secret-Token).
# Если пусто при заданном WEBHOOK_URL — генерируется автоматически на старте.
TELEGRAM_WEBHOOK_SECRET=

# ── Instagram (Wazzup24) ────────────────────────────────────────────
WAZZUP_API_KEY=
WAZZUP_IG_CHANNEL_ID=
WAZZUP_WEBHOOK_SECRET=
WAZZUP_WEBHOOK_BASE_URL=
WAZZUP_WORKER_URL=
WAZZUP_POLL_INTERVAL_MS=3000

# ── Уведомления менеджеру (notify_manager) ──────────────────────────
MANAGER_WA=
MANAGER_GROUP_WA=
MANAGER_TG=
MANAGER_NAME=Менеджер
MANAGER_PUBLIC_CONTACT=
DEVELOPER_WA=

# ── Хранение входящих медиа ─────────────────────────────────────────
# Оригиналы удаляются через 90 дней; транскрипции/описания остаются в архиве.
MEDIA_RETENTION_DAYS=90
MEDIA_MAX_BYTES=33554432

# ── Планировщик отчётов ─────────────────────────────────────────────
# Вечером — сбор статусов с исполнителей, утром — сводка боссу (вс — выходной).
# Выключить: REPORT_SCHEDULER=0. Время локальное (Казахстан UTC+5 = 300 мин).
REPORT_SCHEDULER=1
SCHEDULER_TZ_OFFSET_MIN=300
MORNING_SUMMARY_HOUR=9
EVENING_REPORT_HOUR=18
# Кому утреннюю сводку (цифры WhatsApp через запятую); пусто = BOSS_CONTACTS
SCHEDULER_BOSS_WA=

# ── Ассистентские фичи (веб-поиск, голос) ───────────────────────────
# Веб-поиск: Brave Search API (https://brave.com/search/api/). Пусто → инструмент отключён.
BRAVE_API_KEY=
# Озвучка ответов (TTS): Google Gemini.
# Несколько ключей — через запятую в GOOGLE_GENAI_API_KEYS (круговая ротация по запросам
# для распределения квоты + перебор остальных при 429). Один ключ — GOOGLE_GENAI_API_KEY.
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_API_KEYS=
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Leda
# Озвучивать ответ голосом, когда босс написал голосовым. Выключить: TTS_ENABLED=0
TTS_ENABLED=1
# Fallback-TTS через OpenRouter (если все Google-ключи не ответили). Использует OPENROUTER_API_KEY.
# Модель/голос можно переопределить (id зависит от каталога OpenRouter).
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_TTS_VOICE=Leda

# ── Прочее ──────────────────────────────────────────────────────────
BLOCKED_PHONES=
EXCLUDED_CHAT_ID=
